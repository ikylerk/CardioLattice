# CardioScope Pro / CardioLattice — local research configuration.
# Copy to server/.env for the backend, or export these variables in your shell.

# Storage and database (local-lite profile)
CARDIOSCOPE_VAR_DIR=./var
DB_URL=sqlite:///./var/cardioscope.db
STORAGE_BACKEND=local
STORAGE_DIR=./var/storage

# Pipeline
QUEUE=inline
RUN_PIPELINE_SYNC=0
SEGMENTATION_ADAPTER=synthetic_ground_truth
MAX_UPLOAD_MB=2048
MAX_VOXELS=192
RESAMPLE_MM=1.5

# De-identification salt: change this before handling any real data.
DEID_SALT=change-me-in-production

# Web
ALLOWED_ORIGINS=http://127.0.0.1:5183,http://localhost:5183

# AI report drafting (M2). Keep the key server-side only.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
